---
import Base from '../layouts/Base.astro';
import ItemCard from '../components/ItemCard.astro';
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';

const path = join(process.cwd(), 'src', 'data', 'city.json');
const items = existsSync(path) ? JSON.parse(readFileSync(path, 'utf8')) : [];
---
<Base title="City of St. Clair Shores — Shores Dashboard">
  <p><a href="/">← All sources</a></p>
  <h2>City of St. Clair Shores</h2>
  <p style="color: var(--muted);">News and meeting updates from <a href="https://www.scsmi.net" rel="noopener">scsmi.net</a>.</p>
  {items.length === 0 ? <p>No items yet.</p> : items.map(item => <ItemCard item={item} />)}
</Base>
