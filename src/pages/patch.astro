---
import Base from '../layouts/Base.astro';
import ItemCard from '../components/ItemCard.astro';
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';

const path = join(process.cwd(), 'src', 'data', 'patch.json');
const items = existsSync(path) ? JSON.parse(readFileSync(path, 'utf8')) : [];
---
<Base title="Patch — Shores Dashboard">
  <p><a href="/">← All sources</a></p>
  <h2>Patch — St. Clair Shores</h2>
  <p style="color: var(--muted);">Local news from <a href="https://patch.com/michigan/stclairshores" rel="noopener">patch.com</a>. Headlines only — read full articles at the source.</p>
  {items.length === 0 ? <p>No items yet.</p> : items.map(item => <ItemCard item={item} />)}
</Base>
