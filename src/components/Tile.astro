---
const { label, accent = false } = Astro.props;
---
<section class={`tile${accent ? ' accent' : ''}`}>
  {label && <div class="tile-label mono"><span class="hash">#</span> {label}</div>}
  <slot />
</section>

<style>
  .tile {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1rem 1.1rem 1.1rem;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  .tile.accent {
    border-color: var(--border-2);
  }
  .tile-label {
    font-size: 0.82rem;
    font-weight: 500;
    color: #c8c4b8;
    margin-bottom: 0.7rem;
    letter-spacing: 0.02em;
  }
  .tile-label .hash {
    color: var(--accent);
    margin-right: 0.2rem;
    font-weight: 600;
  }
  :root[data-theme='light'] .tile-label {
    color: #3a3a32;
  }
</style>
