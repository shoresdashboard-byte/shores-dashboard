  }
  .label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #8a6d2e;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  p { margin: 0.25rem 0; font-size: 0.9rem; }
